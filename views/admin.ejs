<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin</title>
  <!-- Favicon -->
  <link rel="icon" href="images/paperson-icon.png">

  <!-- Links -->
  <link href="css/styles.css" rel="stylesheet">
  <link href="css/admin.css" rel="stylesheet">
</head>

<body>
  <main>
    <h1>Admin Page</h1>
    <!-- List of contacts -->
    <% if (!contacts.length == 0) {%>
    <hr>
    <ul>
      <!-- List of contact information -->
      <% contacts.forEach(contact => {%>
      <li>
        <ul>
          <li>Name: <%= contact.fname %> <%=contact.lname%></li>
          <li>Email: <%= contact.email %></li>
          <li>Occupation: <%= contact.jobtitle%></li>
          <li>Company: <%=contact.company%></li>
          <li>LinkedIn: <%=contact.linkedin%></li>
          <li>How We Met: <% if (contact.method=="other") {%><%=contact.other%><%} else {%><%=contact.method%><%}%></li>
      <li>Subscribed to Mailing List: <%=contact.mailinglist%></li>
          <li>Mailing Format: <%=contact.emailformat%></li>
          <li>Message:
            <p><%=contact.message%></p>
          </li>
          <li>Timestamp: <%=contact.timestamp%></li>
        </ul>
      </li>
      <hr>
      <%})%>
    </ul>
    <%} else {%>
    <p>No contacts found.</p>
    <%}%>
    </main>
</body>

</html>